  "Application rules take priority, followed by remembered input methods and the default. Secure password fields are respected.": {
    "extractionState": "manual",
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Application rules take priority, followed by remembered input methods and the default. Secure password fields are respected."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "优先使用应用规则，其次是记忆的输入法，最后使用默认设置。不会干预安全密码输入框。"
        }
      },
      "ja": {
        "stringUnit": {
          "state": "translated",
          "value": "アプリのルール、記憶した入力ソース、既定の設定の順に適用します。安全なパスワード欄には干渉しません。"
        }
      },
      "es": {
        "stringUnit": {
          "state": "translated",
          "value": "Se priorizan las reglas, luego los métodos recordados y el predeterminado. Se respetan los campos de contraseña seguros."
        }
      },
      "fr": {
        "stringUnit": {
          "state": "translated",
          "value": "Priorité aux règles, puis aux méthodes mémorisées et à la valeur par défaut. Les champs de mot de passe sécurisés sont respectés."
        }
      }
    }
  },
