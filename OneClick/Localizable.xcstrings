    "Limits compression threads for ZIP and 7Z. Automatic uses the available logical CPU count. TAR.GZ uses one thread.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Limits compression threads for ZIP and 7Z. Automatic uses the available logical CPU count. TAR.GZ uses one thread."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "限制 ZIP 和 7Z 压缩时使用的线程数。“自动”使用可用的逻辑 CPU 数量。TAR.GZ 使用单线程。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ZIP と 7Z の圧縮スレッド数を制限します。「自動」は利用可能な論理 CPU 数を使用します。TAR.GZ は 1 スレッドを使用します。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Limita los hilos de compresión de ZIP y 7Z. Automático usa el número de CPU lógicas disponibles. TAR.GZ usa un solo hilo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Limite les threads de compression ZIP et 7Z. Le mode automatique utilise le nombre de processeurs logiques disponibles. TAR.GZ utilise un seul thread."
          }
        }
      }
    },
