    "AES-256 protects file contents and file names.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AES-256 protects file contents and file names."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
