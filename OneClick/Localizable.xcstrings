  "Resets compression options, exclusion rules and archive menu settings. File associations are kept.": {
    "extractionState": "manual",
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Resets compression options, exclusion rules and archive menu settings. File associations are kept."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "重置压缩选项、排除规则和压缩解压菜单设置。保留文件关联。"
        }
      },
      "ja": {
        "stringUnit": {
          "state": "translated",
          "value": "圧縮オプション、除外ルール、アーカイブメニューの設定をリセットします。ファイルの関連付けは維持されます。"
        }
      },
      "es": {
        "stringUnit": {
          "state": "translated",
          "value": "Restablece las opciones de compresión, las reglas de exclusión y los ajustes del menú de archivos comprimidos. Se conservan las asociaciones de archivos."
        }
      },
      "fr": {
        "stringUnit": {
          "state": "translated",
          "value": "Réinitialise les options de compression, les règles d’exclusion et les réglages du menu d’archives. Les associations de fichiers sont conservées."
        }
      }
    }
  },
