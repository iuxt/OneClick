  "Uses the chosen app’s icon or the file type’s system icon automatically. The fallback icon is used when neither is available.": {
    "extractionState": "manual",
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Uses the chosen app’s icon or the file type’s system icon automatically. The fallback icon is used when neither is available."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "自动使用所选应用的图标或文件类型的系统图标。两者均不可用时，才使用备用图标。"
        }
      },
      "ja": {
        "stringUnit": {
          "state": "translated",
          "value": "選択したアプリのアイコン、またはファイル形式のシステムアイコンを自動的に使用します。どちらも利用できない場合に代替アイコンを使用します。"
        }
      },
      "es": {
        "stringUnit": {
          "state": "translated",
          "value": "Se usa automáticamente el icono de la aplicación elegida o el icono del sistema para el tipo de archivo. El icono alternativo se usa cuando ninguno está disponible."
        }
      },
      "fr": {
        "stringUnit": {
          "state": "translated",
          "value": "Utilise automatiquement l’icône de l’application choisie ou l’icône système du type de fichier. L’icône de remplacement est utilisée si aucune des deux n’est disponible."
        }
      }
    }
  },
  "Applies to app icons in the Open With menu. Simple icons use the original icon when no matching symbol is available.": {
    "extractionState": "manual",
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Applies to app icons in the Open With menu. Simple icons use the original icon when no matching symbol is available."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "用于“打开方式”菜单中的应用图标。简单图标没有对应符号时，使用原始图标。"
        }
      },
      "ja": {
        "stringUnit": {
          "state": "translated",
          "value": "「このアプリケーションで開く」メニューのアプリアイコンに適用されます。シンプルなアイコンに対応するシンボルがない場合は元のアイコンを使用します。"
        }
      },
      "es": {
        "stringUnit": {
          "state": "translated",
          "value": "Se aplica a los iconos de las aplicaciones del menú Abrir con. Los iconos simples usan el icono original si no hay un símbolo correspondiente."
        }
      },
      "fr": {
        "stringUnit": {
          "state": "translated",
          "value": "S’applique aux icônes des applications du menu Ouvrir avec. Les icônes simples utilisent l’icône d’origine si aucun symbole correspondant n’est disponible."
        }
      }
    }
  },
