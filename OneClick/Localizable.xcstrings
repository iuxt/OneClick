{
  "sourceLanguage" : "en",
  "strings" : {
  "A built-in blank document is used by default. Custom templates are optional.": {
    "extractionState": "manual",
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "A built-in blank document is used by default. Custom templates are optional."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "默认使用内置空白文档，无需配置模板；也可按需选择自定义模板。"
        }
      },
      "ja": {
        "stringUnit": {
          "state": "translated",
          "value": "標準では内蔵の空白書類を使用します。カスタムテンプレートの設定は任意です。"
        }
      },
      "es": {
        "stringUnit": {
          "state": "translated",
          "value": "De forma predeterminada se usa un documento en blanco integrado. Las plantillas personalizadas son opcionales."
        }
      },
      "fr": {
        "stringUnit": {
          "state": "translated",
          "value": "Un document vierge intégré est utilisé par défaut. Les modèles personnalisés sont facultatifs."
        }
      }
    }
  },
  "Extracting…": {
    "extractionState": "manual",
