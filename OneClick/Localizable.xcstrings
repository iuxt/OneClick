    "Enter one file or folder name pattern per line, for example .DS_Store, node_modules or *.tmp. Matches are excluded at every folder level during compression.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter one file or folder name pattern per line, for example .DS_Store, node_modules or *.tmp. Matches are excluded at every folder level during compression."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每行输入一个文件或文件夹名称规则，例如 .DS_Store、node_modules 或 *.tmp。压缩时会排除各级目录中匹配的项目。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各行にファイル名またはフォルダ名のパターン（.DS_Store、node_modules、*.tmp など）を入力します。圧縮時にすべての階層で一致する項目を除外します。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce un patrón de nombre de archivo o carpeta por línea, por ejemplo .DS_Store, node_modules o *.tmp. Las coincidencias se excluyen en todos los niveles al comprimir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez un motif de nom de fichier ou de dossier par ligne, par exemple .DS_Store, node_modules ou *.tmp. Les éléments correspondants sont exclus à tous les niveaux lors de la compression."
          }
        }
      }
    },
