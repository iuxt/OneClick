      }
    },
    "ZIP passwords must use 1–99 printable ASCII characters. Use Encrypted 7Z for other characters.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ZIP passwords must use 1–99 printable ASCII characters. Use Encrypted 7Z for other characters."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "ZIP 密码须为 1–99 个可打印的 ASCII 字符。需要中文等其他字符时，请使用加密 7Z。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ZIP のパスワードは表示可能な ASCII 文字で 1～99 文字です。その他の文字には暗号化 7Z を使用してください。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las contraseñas ZIP deben tener entre 1 y 99 caracteres ASCII imprimibles. Para otros caracteres, usa 7Z cifrado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les mots de passe ZIP doivent contenir de 1 à 99 caractères ASCII imprimables. Pour d’autres caractères, utilisez 7Z chiffré."
          }
        }
      }
    },
    "Choose Encrypted ZIP or Encrypted 7Z for password protection.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose Encrypted ZIP or Encrypted 7Z for password protection."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要密码保护时，请选择加密 ZIP 或加密 7Z。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスワード保護には暗号化 ZIP または暗号化 7Z を選択してください。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para proteger con contraseña, elige ZIP cifrado o 7Z cifrado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour protéger par mot de passe, choisissez ZIP chiffré ou 7Z chiffré."
