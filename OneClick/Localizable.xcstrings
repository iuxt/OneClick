  "This restores default app settings. Folder permissions, login items and file associations are kept. This action cannot be undone.": {
    "extractionState": "manual",
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "This restores default app settings. Folder permissions, login items and file associations are kept. This action cannot be undone."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "这将恢复应用的默认设置，并保留文件夹权限、登录项和文件关联。此操作无法撤销。"
        }
      },
      "ja": {
        "stringUnit": {
          "state": "translated",
          "value": "アプリの設定を初期値に戻します。フォルダのアクセス権、ログイン項目、ファイルの関連付けは保持されます。この操作は取り消せません。"
        }
      },
      "es": {
        "stringUnit": {
          "state": "translated",
          "value": "Se restauran los ajustes predeterminados. Se conservan los permisos de carpetas, elementos de inicio y asociaciones de archivos. Esta acción no se puede deshacer."
        }
      },
      "fr": {
        "stringUnit": {
          "state": "translated",
          "value": "Les réglages par défaut seront rétablis. Les autorisations de dossiers, éléments de connexion et associations de fichiers seront conservés. Cette action est irréversible."
        }
      }
    }
  },
