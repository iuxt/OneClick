  "Settings backups are limited to 64 MiB of template data and 10,000 files.": {
    "extractionState": "manual",
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Settings backups are limited to 64 MiB of template data and 10,000 files."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "设置备份最多包含 64 MiB 模板数据和 10,000 个文件。"
        }
      },
      "ja": {
        "stringUnit": {
          "state": "translated",
          "value": "設定バックアップの上限はテンプレートデータ 64 MiB、ファイル数 10,000 です。"
        }
      },
      "es": {
        "stringUnit": {
          "state": "translated",
          "value": "Las copias se limitan a 64 MiB de plantillas y 10.000 archivos."
        }
      },
      "fr": {
        "stringUnit": {
          "state": "translated",
          "value": "Les sauvegardes sont limitées à 64 Mio de modèles et 10 000 fichiers."
        }
      }
    }
  },
  "Backups include app settings and templates. Folder permissions, login items and file associations are managed separately.": {
    "extractionState": "manual",
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Backups include app settings and templates. Folder permissions, login items and file associations are managed separately."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "备份包含应用设置和模板。文件夹权限、登录项和文件关联由各自入口单独管理。"
        }
      },
      "ja": {
        "stringUnit": {
          "state": "translated",
          "value": "バックアップにはアプリの設定とテンプレートが含まれます。フォルダのアクセス権、ログイン項目、ファイルの関連付けは個別に管理されます。"
        }
      },
      "es": {
        "stringUnit": {
          "state": "translated",
          "value": "Las copias incluyen ajustes y plantillas. Los permisos de carpetas, elementos de inicio y asociaciones de archivos se gestionan por separado."
        }
      },
      "fr": {
        "stringUnit": {
          "state": "translated",
          "value": "Les sauvegardes incluent les réglages et les modèles. Les autorisations de dossiers, éléments de connexion et associations de fichiers sont gérés séparément."
        }
      }
    }
  },
