        }
      },
      "fr": {
        "stringUnit": {
          "state": "translated",
          "value": "Extraction…"
        }
      }
    }
  },
  "The built-in template is missing. Reinstall OneClick and try again.": {
    "extractionState": "manual",
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "The built-in template is missing. Reinstall OneClick and try again."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "内置模板缺失。请重新安装 OneClick 后重试。"
        }
      },
      "ja": {
        "stringUnit": {
          "state": "translated",
          "value": "内蔵テンプレートが見つかりません。OneClick を再インストールして、もう一度お試しください。"
        }
      },
      "es": {
        "stringUnit": {
          "state": "translated",
          "value": "Falta la plantilla integrada. Reinstala OneClick e inténtalo de nuevo."
        }
      },
      "fr": {
        "stringUnit": {
          "state": "translated",
          "value": "Le modèle intégré est manquant. Réinstallez OneClick et réessayez."
        }
      }
    }
  },
