        "stringUnit": {
          "state": "translated",
          "value": "This entry cannot be previewed. Folders, links, duplicate names and unsafe paths are excluded."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "此条目无法预览。不支持文件夹、链接、重复文件名和不安全的路径。"
        }
      },
      "ja": {
        "stringUnit": {
          "state": "translated",
