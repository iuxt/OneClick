    "Keep all volumes together. Open the .001 file to extract.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep all volumes together. Open the .001 file to extract."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请将所有分卷保存在同一文件夹中，打开 .001 文件即可解压。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのボリュームを同じフォルダに置き、.001 ファイルを開いて展開してください。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén todos los volúmenes juntos. Abre el archivo .001 para extraerlos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conservez tous les volumes ensemble. Ouvrez le fichier .001 pour les extraire."
          }
        }
      }
    },
    "Compresses files together for smaller archives. Extracting individual files may take longer.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compresses files together for smaller archives. Extracting individual files may take longer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将文件一起压缩以减小体积，单独解压某个文件可能需要更长时间。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルをまとめて圧縮してサイズを縮小します。個別ファイルの展開に時間がかかる場合があります。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprime los archivos juntos para reducir el tamaño. Extraer archivos individuales puede tardar más."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Compresse les fichiers ensemble pour réduire la taille. L’extraction de fichiers individuels peut prendre plus de temps."
          }
        }
      }
    },
