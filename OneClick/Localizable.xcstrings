  "Switch to an application to use its assigned input method.": {
    "extractionState": "manual",
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Switch to an application to use its assigned input method."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "切换到应用时，自动使用为它指定的输入法。"
        }
      },
      "ja": {
        "stringUnit": {
          "state": "translated",
          "value": "アプリに切り替えると、指定した入力ソースが使用されます。"
        }
      },
      "es": {
        "stringUnit": {
          "state": "translated",
          "value": "Al cambiar a una aplicación, se usará su método de entrada asignado."
        }
      },
      "fr": {
        "stringUnit": {
          "state": "translated",
          "value": "Passez à une application pour utiliser la méthode de saisie qui lui est attribuée."
