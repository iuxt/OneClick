  "Restore Default File Types?": {
    "extractionState": "manual",
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Restore Default File Types?"
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "恢复默认文件类型？"
        }
      },
      "ja": {
        "stringUnit": {
          "state": "translated",
          "value": "デフォルトのファイル形式に戻しますか？"
        }
      },
      "es": {
        "stringUnit": {
          "state": "translated",
          "value": "¿Restaurar los tipos de archivo predeterminados?"
        }
      },
      "fr": {
        "stringUnit": {
          "state": "translated",
          "value": "Restaurer les types de fichiers par défaut ?"
        }
      }
    }
  },
  "This replaces all file types with the defaults, removing custom types and resetting names, templates, icons, app choices and enabled states. This cannot be undone.": {
    "extractionState": "manual",
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "This replaces all file types with the defaults, removing custom types and resetting names, templates, icons, app choices and enabled states. This cannot be undone."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "这将用默认文件类型替换全部配置，移除自定义类型，并重置名称、模板、图标、打开应用和启用状态。此操作无法撤销。"
        }
      },
      "ja": {
        "stringUnit": {
          "state": "translated",
          "value": "すべてのファイル形式をデフォルトに置き換え、カスタム形式を削除し、名前、テンプレート、アイコン、使用するアプリ、有効状態をリセットします。この操作は取り消せません。"
        }
      },
      "es": {
        "stringUnit": {
          "state": "translated",
          "value": "Se reemplazarán todos los tipos de archivo por los predeterminados, se eliminarán los personalizados y se restablecerán los nombres, las plantillas, los iconos, las aplicaciones y los estados de activación. Esta acción no se puede deshacer."
        }
      },
      "fr": {
        "stringUnit": {
          "state": "translated",
          "value": "Tous les types de fichiers seront remplacés par les valeurs par défaut. Les types personnalisés seront supprimés et les noms, modèles, icônes, applications et états d’activation seront réinitialisés. Cette action est irréversible."
        }
      }
    }
  },
