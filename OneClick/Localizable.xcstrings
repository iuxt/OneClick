    "Compress… opens a window to adjust these options and set an optional password.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compress… opens a window to adjust these options and set an optional password."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击“自定义压缩”后，可在窗口中调整这些选项并设置密码。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「圧縮…」でウインドウを開き、設定の変更やパスワードの設定ができます。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprimir… abre una ventana para ajustar estas opciones y establecer una contraseña opcional."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Compresser… ouvre une fenêtre pour régler ces options et définir un mot de passe facultatif."
          }
        }
      }
    },
    "Higher compression levels can create smaller archives but take more time.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Higher compression levels can create smaller archives but take more time."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "压缩率越高，压缩包通常越小，但耗时也越长。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "圧縮レベルを上げるとサイズが小さくなる場合がありますが、時間がかかります。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los niveles más altos pueden crear archivos más pequeños, pero tardan más."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un niveau plus élevé peut produire des archives plus petites, mais prend plus de temps."
          }
        }
      }
    },
    "TAR.GZ does not support passwords.": {
      "extractionState": "manual",
      "localizations": {
